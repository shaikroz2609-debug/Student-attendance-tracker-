* { box-sizing: border-box; }
body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: #f1f5f9; color: #1e293b; }
.app-header { background: linear-gradient(135deg, #1d4ed8, #4f46e5); color: #fff; padding: 22px 32px; }
.app-header h1 { margin: 0 0 4px; font-size: 26px; }
.app-header p { margin: 0; opacity: .9; font-size: 14px; }
main { max-width: 1150px; margin: 20px auto; padding: 0 16px; }

/* Summary cards */
.summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 14px; }
.card { background: #fff; border-radius: 10px; padding: 14px 18px; box-shadow: 0 1px 4px rgba(0,0,0,.08); border-left: 5px solid #2563eb; }
.card span { font-size: 13px; color: #64748b; }
.card strong { display: block; font-size: 26px; margin-top: 4px; }
.card.green { border-color: #16a34a; } .card.red { border-color: #dc2626; } .card.orange { border-color: #ea580c; }

/* Toolbar */
.toolbar { display: flex; flex-wrap: wrap; gap: 14px; background: #fff; padding: 14px 18px; border-radius: 10px; margin: 18px 0; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
label { display: flex; flex-direction: column; font-size: 13px; font-weight: 600; gap: 4px; }
input, select { padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; min-width: 150px; }
input:focus, select:focus { outline: 2px solid #93c5fd; }

/* Tabs and panels */
.tabs { display: flex; gap: 6px; }
.tab { padding: 10px 22px; border: none; background: #e2e8f0; border-radius: 8px 8px 0 0; cursor: pointer; font-weight: 600; }
.tab.active { background: #fff; color: #1d4ed8; }
.panel { background: #fff; padding: 18px; border-radius: 0 10px 10px 10px; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
.panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.panel-head h2 { margin: 0; font-size: 18px; }
.hidden { display: none !important; }

/* Table */
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th { background: #eff6ff; text-align: left; padding: 10px; color: #1e40af; }
td { padding: 10px; border-bottom: 1px solid #e2e8f0; }
tr.low { background: #fef2f2; }
tr.low td:first-child { border-left: 4px solid #dc2626; }
.empty { text-align: center; color: #64748b; padding: 24px; }

/* Buttons and badges */
.btn { padding: 8px 14px; border: 1px solid #cbd5e1; background: #fff; border-radius: 6px; cursor: pointer; font-size: 13px; }
.btn:hover { background: #f1f5f9; }
.btn.primary { background: #2563eb; color: #fff; border-color: #2563eb; }
.btn.danger { color: #dc2626; border-color: #fca5a5; }
.btn.small { padding: 5px 9px; margin-right: 3px; }
.badge { padding: 3px 10px; border-radius: 12px; font-size: 12px; font-weight: 600; }
.badge.Present { background: #dcfce7; color: #166534; } .badge.Absent { background: #fee2e2; color: #991b1b; }
.badge.Late { background: #fef3c7; color: #92400e; } .badge.Leave { background: #e0e7ff; color: #3730a3; }
.badge.none { background: #f1f5f9; color: #64748b; }
.pct-low { color: #dc2626; font-weight: 700; } .pct-ok { color: #16a34a; font-weight: 700; }
.status-btn.sel-Present { background: #16a34a; color: #fff; } .status-btn.sel-Absent { background: #dc2626; color: #fff; }
.status-btn.sel-Late { background: #f59e0b; color: #fff; } .status-btn.sel-Leave { background: #6366f1; color: #fff; }

/* Modal and toast */
.modal { position: fixed; inset: 0; background: rgba(15,23,42,.5); display: flex; align-items: center; justify-content: center; z-index: 10; }
.modal-box { background: #fff; padding: 22px; border-radius: 12px; width: 92%; max-width: 440px; display: flex; flex-direction: column; gap: 12px; max-height: 85vh; overflow-y: auto; }
.modal-box h3 { margin: 0; }
.modal-box input { width: 100%; }
.modal-actions { display: flex; justify-content: flex-end; gap: 8px; }
.error { color: #dc2626; font-size: 13px; margin: 0; min-height: 16px; }
#toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: #1e293b; color: #fff; padding: 11px 20px; border-radius: 8px; opacity: 0; pointer-events: none; transition: opacity .3s; z-index: 20; }
#toast.show { opacity: 1; }

@media (max-width: 600px) { .app-header h1 { font-size: 21px; } input, select { min-width: 120px; } }
